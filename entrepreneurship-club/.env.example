# Supabase environment variables for the Entrepreneurship Club site.
# Copy to .env for local dev — never commit .env to version control.
#
# This is a separate Netlify site from the Orozco Homes app, so these must
# be set independently under this site's own Site → Settings → Environment
# variables. They can point at the SAME Supabase project as the Orozco
# Homes app (the two apps only ever touch their own tables — see
# supabase/migrations/021_entrepreneurship_club.sql at the repo root) or a
# different one entirely.

# Found in: Supabase Dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Found in: Supabase Dashboard → Project Settings → API → anon public key
# This key is safe to expose in frontend code.
VITE_SUPABASE_ANON_KEY=your-anon-key-here
